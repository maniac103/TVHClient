<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <com.google.android.material.card.MaterialCardView
        style="?materialCardViewFilledStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="?colorSurfaceContainerLow">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <ImageView
                android:id="@+id/channel_info_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:src="@drawable/ic_tv_station"
                android:scaleType="center"
                app:tint="?colorOnSurfaceVariant" />

            <ImageView
                android:id="@+id/channel_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:layout_constraintStart_toEndOf="@id/channel_info_icon"
                app:layout_constraintTop_toTopOf="@id/channel_info_icon" />

            <TextView
                android:id="@+id/channel"
                style="@style/ContentFont"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="8dp"
                app:layout_goneMarginStart="0dp"
                app:layout_constraintStart_toEndOf="@id/channel_icon"
                app:layout_constraintTop_toTopOf="@id/channel_info_icon"
                app:layout_constraintBottom_toBottomOf="@id/channel_info_icon"
                app:layout_constraintEnd_toEndOf="parent"
                android:gravity="center_vertical"
                tools:text="@string/channel" />

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/channel_barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="channel_info_icon,channel_icon,channel" />

            <ImageView
                android:id="@+id/disabled_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/channel_barrier"
                android:src="@drawable/ic_disabled"
                android:scaleType="center"
                app:tint="?colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/disabled"
                style="@style/ContentFont"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/disabled_icon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/disabled_icon"
                app:layout_constraintBottom_toBottomOf="@id/disabled_icon"
                android:text="@string/recording_disabled" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        style="?materialCardViewFilledStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="?colorSurfaceContainerLow">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <ImageView
                android:id="@+id/time_info_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:src="@drawable/ic_rec_state_scheduled"
                android:scaleType="center"
                app:tint="?colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/time_window_label"
                style="@style/ContentLabelFont"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/time_window"
                app:layout_constraintStart_toEndOf="@id/time_info_icon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/start_after_time"
                style="@style/ContentFont"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="@id/time_window_label"
                app:layout_constraintTop_toBottomOf="@id/time_window_label"
                tools:text="@tools:sample/date/hhmm" />

            <TextView
                android:id="@+id/start_before_time"
                style="@style/ContentFont"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="@id/time_window_label"
                app:layout_constraintTop_toBottomOf="@id/start_after_time"
                tools:text="@string/start_before_time" />

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/time_barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:barrierMargin="16dp"
                app:constraint_referenced_ids="time_info_icon,start_after_time,start_before_time" />

            <ImageView
                android:id="@+id/duration_info_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/time_barrier"
                android:src="@drawable/ic_duration"
                android:scaleType="center"
                app:tint="?colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/minimum_duration_label"
                style="@style/ContentLabelFont"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/min_duration"
                app:layout_constraintStart_toEndOf="@id/duration_info_icon"
                app:layout_constraintTop_toTopOf="@id/duration_info_icon" />

            <TextView
                android:id="@+id/minimum_duration"
                style="@style/ContentFont"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="@id/minimum_duration_label"
                app:layout_constraintTop_toBottomOf="@id/minimum_duration_label"
                tools:text="@string/minutes" />

            <TextView
                android:id="@+id/maximum_duration_label"
                style="@style/ContentLabelFont"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/max_duration"
                app:layout_constraintStart_toEndOf="@id/duration_info_icon"
                app:layout_constraintTop_toBottomOf="@id/minimum_duration" />

            <TextView
                android:id="@+id/maximum_duration"
                style="@style/ContentFont"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="@id/maximum_duration_label"
                app:layout_constraintTop_toBottomOf="@id/maximum_duration_label"
                tools:text="@string/minutes" />

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/duration_barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:barrierMargin="16dp"
                app:constraint_referenced_ids="duration_info_icon,maximum_duration" />

            <ImageView
                android:id="@+id/calendar_info_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/duration_barrier"
                android:src="@drawable/ic_calendar"
                android:scaleType="center"
                app:tint="?colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/days_of_week_label"
                style="@style/ContentLabelFont"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/calendar_info_icon"
                app:layout_constraintTop_toTopOf="@id/calendar_info_icon"
                android:text="@string/days_of_week" />

            <TextView
                android:id="@+id/days_of_week"
                style="@style/ContentFont"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/calendar_info_icon"
                app:layout_constraintTop_toBottomOf="@id/days_of_week_label"
                tools:text="@string/days_of_week" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        style="?materialCardViewFilledStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="?colorSurfaceContainerLow">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <ImageView
                android:id="@+id/settings_info_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:src="@drawable/ic_menu_settings"
                android:scaleType="center"
                app:tint="?colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/duplicate_detection_label"
                style="@style/ContentLabelFont"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/duplicate_detection"
                app:layout_constraintStart_toEndOf="@id/settings_info_icon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/duplicate_detection"
                style="@style/ContentFont"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="@id/duplicate_detection_label"
                app:layout_constraintTop_toBottomOf="@id/duplicate_detection_label" />

            <TextView
                android:id="@+id/priority_label"
                style="@style/ContentLabelFont"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/priority"
                app:layout_constraintStart_toEndOf="@id/settings_info_icon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/duplicate_detection" />

            <TextView
                android:id="@+id/priority"
                style="@style/ContentFont"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="@id/priority_label"
                app:layout_constraintTop_toBottomOf="@id/priority_label"
                tools:text="@string/priority" />

            <TextView
                android:id="@+id/directory_label"
                style="@style/ContentLabelFont"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/directory"
                app:layout_constraintStart_toEndOf="@id/settings_info_icon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/priority" />

            <TextView
                android:id="@+id/directory"
                style="@style/ContentFont"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="@id/directory_label"
                app:layout_constraintTop_toBottomOf="@id/directory_label"
                tools:text="@string/add_recording_directory" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
